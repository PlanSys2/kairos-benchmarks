(define (problem elevator-1-3-2) (:domain elevator-of)
  (:objects e0 - elevator f0 f1 f2 - floor q0 q1 - passenger)
  (:init (above f1 f0)
    (above f2 f0)
    (above f2 f1)
    (serves e0 f0)
    (serves e0 f1)
    (serves e0 f2)
    (= (floor-of e0) f0)
    (= (waiting q0) f2) (= (dest q0) f2)
    (= (waiting q1) f2) (= (dest q1) f1))
  (:goal (and (served q0) (served q1))))
