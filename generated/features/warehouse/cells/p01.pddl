(define (problem wh-cells-2) (:domain warehouse-cells)
  (:objects r0 r1 - robot z1_0 z1_1 z1_2 z2_0 z2_1 z2_2 z3_0 z3_1 z3_2 w1 - zone s0 s2 - station pod0 pod1 pod2 pod3 - pod it0 it1 - item)
  (:init (aisle s0 z1_0) (aisle z1_0 s0)
    (aisle s0 w1) (aisle w1 s0)
    (aisle w1 z1_1) (aisle z1_1 w1)
    (aisle w1 s2) (aisle s2 w1)
    (aisle s2 z1_2) (aisle z1_2 s2)
    (aisle z1_0 z2_0) (aisle z2_0 z1_0)
    (aisle z1_0 z1_1) (aisle z1_1 z1_0)
    (aisle z1_1 z2_1) (aisle z2_1 z1_1)
    (aisle z1_1 z1_2) (aisle z1_2 z1_1)
    (aisle z1_2 z2_2) (aisle z2_2 z1_2)
    (aisle z2_0 z3_0) (aisle z3_0 z2_0)
    (aisle z2_0 z2_1) (aisle z2_1 z2_0)
    (aisle z2_1 z3_1) (aisle z3_1 z2_1)
    (aisle z2_1 z2_2) (aisle z2_2 z2_1)
    (aisle z2_2 z3_2) (aisle z3_2 z2_2)
    (aisle z3_0 z3_1) (aisle z3_1 z3_0)
    (aisle z3_1 z3_2) (aisle z3_2 z3_1)
    (pod-at pod0 z2_2) (home pod0 z2_2)
    (pod-at pod1 z3_2) (home pod1 z3_2)
    (pod-at pod2 z3_1) (home pod2 z3_1)
    (pod-at pod3 z3_0) (home pod3 z3_0)
    (at r0 z1_0) (empty r0)
    (at r1 z1_1) (empty r1)
    (clear s0)
    (clear s2)
    (clear z1_2)
    (clear z2_0)
    (clear z2_1)
    (clear z2_2)
    (clear z3_0)
    (clear z3_1)
    (clear z3_2)
    (has pod2 it0) (order it0 s0)
    (has pod0 it1) (order it1 s0)
    (= (total-cost) 0))
  (:goal (and (delivered it0 s0) (delivered it1 s0) (pod-at pod0 z2_2) (pod-at pod1 z3_2) (pod-at pod2 z3_1) (pod-at pod3 z3_0)))
  (:metric minimize (total-cost)))
