#!/bin/bash
# DOMAIN PROBLEM: the plan goes to sas_plan (anytime planners: sas_plan.1, .2...) in the current
# directory; the time limit is $KAIROS_TIMEOUT seconds (a few less, to write the last plan)
T=$(( ${KAIROS_TIMEOUT:-30} - 2 ))
exec pypy3 /p/decstar/fast-downward.py --build release64 --overall-time-limit ${T}s \
  --alias seq-agl-decstar --plan-file sas_plan "$1" "$2"
