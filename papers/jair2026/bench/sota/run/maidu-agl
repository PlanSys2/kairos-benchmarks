exec pypy3 /p/maidu/fast-downward.py --overall-time-limit ${T}s --alias seq-agl-maidu \
  --portfolio-single-plan --plan-file sas_plan "$1" "$2" \
  --translate-options --invariant-generation-max-candidates 0
