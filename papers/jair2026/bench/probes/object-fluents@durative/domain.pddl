(define (domain of) (:requirements :durative-actions :strips :typing :object-fluents)
 (:types robot place)
 (:predicates (link ?a ?b - place) (arrived ?r - robot))
 (:functions (loc ?r - robot) - place)
 (:durative-action move :parameters (?r - robot ?a ?b - place) :duration (= ?duration 1)
  :condition (and (at start (= (loc ?r) ?a)) (at start (link ?a ?b)))
  :effect (and (at end (assign (loc ?r) ?b))))
 (:durative-action finish :parameters (?r - robot ?b - place) :duration (= ?duration 1)
  :condition (and (at start (= (loc ?r) ?b)) (at start (link ?b ?b)))
  :effect (and (at end (arrived ?r)))))
