(define (domain pe) (:requirements :strips :typing :fluents :negative-preconditions :time)
 (:types robot)
 (:predicates (ready ?r - robot) (pumping ?r - robot) (overflow ?r - robot) (full ?r - robot))
 (:functions (level ?r - robot))
 (:action pump-on :parameters (?r - robot) :precondition (and (ready ?r) (not (pumping ?r))) :effect (and (pumping ?r)))
 (:action pump-off :parameters (?r - robot) :precondition (and (pumping ?r)) :effect (and (not (pumping ?r))))
 (:action check :parameters (?r - robot) :precondition (and (not (pumping ?r)) (>= (level ?r) 5))
  :effect (and (full ?r)))
 (:process fill :parameters (?r - robot) :precondition (and (pumping ?r))
  :effect (and (increase (level ?r) (* #t 1))))
 (:event spill :parameters (?r - robot) :precondition (and (pumping ?r) (>= (level ?r) 10))
  :effect (and (overflow ?r))))
