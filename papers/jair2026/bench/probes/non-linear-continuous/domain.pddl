(define (domain nc) (:requirements :strips :typing :fluents :negative-preconditions :time)
 (:types robot)
 (:predicates (ready ?r - robot) (growing ?r - robot) (big ?r - robot))
 (:functions (size ?r - robot))
 (:action grow-on :parameters (?r - robot) :precondition (and (ready ?r) (not (growing ?r))) :effect (and (growing ?r)))
 (:action grow-off :parameters (?r - robot) :precondition (and (growing ?r)) :effect (and (not (growing ?r))))
 (:action check :parameters (?r - robot)
  :precondition (and (not (growing ?r)) (>= (size ?r) 2) (<= (size ?r) 3)) :effect (and (big ?r)))
 (:process grow :parameters (?r - robot) :precondition (and (growing ?r))
  :effect (and (increase (size ?r) (* #t (size ?r))))))
