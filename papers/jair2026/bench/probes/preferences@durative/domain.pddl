(define (domain pr) (:requirements :durative-actions :strips :typing :preferences)
 (:types robot)
 (:predicates (ready ?r - robot) (a ?r - robot) (b ?r - robot))
 (:durative-action do-a :parameters (?r - robot) :duration (= ?duration 1)
  :condition (and (at start (ready ?r)))
  :effect (and (at end (a ?r))))
 (:durative-action do-b :parameters (?r - robot) :duration (= ?duration 1)
  :condition (and (at start (ready ?r)))
  :effect (and (at end (b ?r)))))
