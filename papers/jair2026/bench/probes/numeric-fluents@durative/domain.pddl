(define (domain nf) (:requirements :durative-actions :strips :typing :fluents)
 (:types robot)
 (:predicates (ready ?r - robot) (done ?r - robot))
 (:functions (load ?r - robot))
 (:durative-action pick :parameters (?r - robot) :duration (= ?duration 1)
  :condition (and (at start (ready ?r)) (at start (< (load ?r) 10)))
  :effect (and (at end (increase (load ?r) 1))))
 (:durative-action finish :parameters (?r - robot) :duration (= ?duration 1)
  :condition (and (at start (>= (load ?r) 3)))
  :effect (and (at end (done ?r)))))
