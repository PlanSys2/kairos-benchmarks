(define (domain dp) (:requirements :durative-actions :strips :typing :disjunctive-preconditions)
 (:types robot)
 (:predicates (ready ?r - robot) (left ?r - robot) (right ?r - robot) (done ?r - robot))
 (:durative-action go-right :parameters (?r - robot) :duration (= ?duration 1)
  :condition (and (at start (ready ?r)))
  :effect (and (at end (right ?r))))
 (:durative-action finish :parameters (?r - robot) :duration (= ?duration 1)
  :condition (and (at start (or (left ?r) (right ?r))))
  :effect (and (at end (done ?r)))))
