(define (domain cl) (:requirements :strips :typing :durative-actions :fluents :continuous-effects)
 (:types robot)
 (:predicates (free ?r - robot) (full ?r - robot))
 (:functions (water ?r - robot))
 (:durative-action fill :parameters (?r - robot) :duration (= ?duration 3)
  :condition (and (at start (free ?r)))
  :effect (and (at start (not (free ?r))) (at end (free ?r)) (increase (water ?r) (* #t 1))))
 (:action check :parameters (?r - robot) :precondition (and (free ?r) (>= (water ?r) 5))
  :effect (and (full ?r))))
