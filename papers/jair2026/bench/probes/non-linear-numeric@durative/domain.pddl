(define (domain nl) (:requirements :durative-actions :strips :typing :fluents)
 (:types robot)
 (:predicates (ready ?r - robot) (done ?r - robot))
 (:functions (speed ?r - robot))
 (:durative-action accelerate :parameters (?r - robot) :duration (= ?duration 1)
  :condition (and (at start (ready ?r)) (at start (< (speed ?r) 10)))
  :effect (and (at end (increase (speed ?r) 1))))
 (:durative-action finish :parameters (?r - robot) :duration (= ?duration 1)
  :condition (and (at start (>= (* (speed ?r) (speed ?r)) 9)))
  :effect (and (at end (done ?r)))))
