(define (domain qp) (:requirements :durative-actions :strips :typing :quantified-preconditions)
 (:types robot box)
 (:predicates (ready ?r - robot) (open ?b - box) (done ?r - robot))
 (:durative-action open-box :parameters (?r - robot ?b - box) :duration (= ?duration 1)
  :condition (and (at start (ready ?r)))
  :effect (and (at end (open ?b))))
 (:durative-action finish :parameters (?r - robot) :duration (= ?duration 1)
  :condition (and (at start (ready ?r)) (at start (forall (?b - box) (open ?b))))
  :effect (and (at end (done ?r)))))
